# Copy to ignored .env.local for local development. Never commit actual credentials.
COMMERCE_MODE=development
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_CHECKOUT_ENABLED=false
SHOPIFY_CHECKOUT_HOST=
SHOPIFY_CUSTOMER_ACCOUNT_URL=
SHOPIFY_VERIFIED_PRODUCT_HANDLES=
MARKET_COUNTRY=AU
MARKET_CURRENCY=AUD
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
INDEXING_ENABLED=false
NEXT_PUBLIC_VITALS_ENDPOINT=
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_TOKEN=
TRUST_PROXY_HEADERS=false

# Optional local draft-catalogue import only; never install this in the storefront runtime.
SHOPIFY_ADMIN_ACCESS_TOKEN=
